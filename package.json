{
  "name": "stakeos",
  "version": "1.0.0",
  "private": true,
  "description": "Private AI assistant and leadership dashboard for stake leadership.",
  "author": "Nicholas Naugle",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run build:backend",
    "build:backend": "tsup src/mcp/server.ts src/scripts/runFullSync.ts src/scripts/runCallingSync.ts src/db/migrate.ts src/scripts/seedSyncSnapshots.ts --format cjs --out-dir dist --clean && cp dist/mcp/server.cjs dist/server.cjs",
    "desktop:start": "electron electron/main.cjs",
    "desktop:clean": "rm -rf release",
    "desktop:check-release": "node scripts/checkMacReleasePrereqs.mjs",
    "desktop:pack": "npm run build && electron-builder --dir",
    "desktop:release": "npm run desktop:clean && npm run build && electron-builder --mac zip dmg",
    "desktop:dist": "npm run desktop:release",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/db/migrate.ts",
    "sqlite:spike:init": "tsx src/sqlite-spike/init.ts",
    "sqlite:spike:sync": "tsx src/sqlite-spike/runFullSync.ts",
    "sqlite:spike:callings": "tsx src/sqlite-spike/runCallingSync.ts",
    "sqlite:spike:seed-baseline": "tsx src/sqlite-spike/seedSyncSnapshots.ts",
    "sync:seed-baseline": "tsx src/scripts/seedSyncSnapshots.ts",
    "sync:full": "tsx src/scripts/runFullSync.ts",
    "sync:callings": "tsx src/scripts/runCallingSync.ts",
    "sync:rebuild-callings": "tsx src/scripts/rebuildCallingsFromStoredColumns.ts",
    "mcp:dev": "tsx src/mcp/server.ts",
    "mcp:build": "tsup src/mcp/server.ts --format cjs --out-dir dist --clean",
    "mcp:start": "node dist/server.cjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.8.0",
    "better-sqlite3": "^12.8.0",
    "d3": "^7.9.0",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.5",
    "next": "^14.2.5",
    "nodemailer": "^6.9.15",
    "pg": "^8.13.0",
    "playwright": "^1.49.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.1",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "electron": "^41.0.3",
    "electron-builder": "^26.0.12",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.5",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "build": {
    "appId": "org.stakeos.desktop",
    "productName": "StakeOS Desktop",
    "icon": "build/icon.icns",
    "asar": false,
    "afterSign": "build/notarize.cjs",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "artifactName": "StakeOS-Desktop-${version}-${arch}.${ext}",
    "files": [
      "electron/**/*",
      ".next/**/*",
      "dist/**/*",
      "public/**/*",
      "src/db/schema.sql",
      "package.json",
      "package-lock.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        "zip",
        "dmg"
      ]
    },
    "dmg": {
      "artifactName": "StakeOS-Desktop-${version}-${arch}.${ext}",
      "sign": false
    }
  }
}
