{
  "name": "stakeos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:all": "concurrently \"next dev\" \"tsx src/scheduler/runScheduler.ts\"",
    "build": "next build && npm run build:backend",
    "build:backend": "tsup src/mcp/server.ts src/scheduler/runScheduler.ts src/scripts/runFullSync.ts src/scripts/runCallingSync.ts --format cjs --out-dir dist --clean && cp dist/mcp/server.cjs dist/server.cjs",
    "desktop:start": "electron electron/main.cjs",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/db/migrate.ts",
    "sync:seed-baseline": "tsx src/scripts/seedSyncSnapshots.ts",
    "sync:full": "tsx src/scripts/runFullSync.ts",
    "sync:callings": "tsx src/scripts/runCallingSync.ts",
    "sync:rebuild-callings": "tsx src/scripts/rebuildCallingsFromStoredColumns.ts",
    "scheduler": "tsx src/scheduler/runScheduler.ts",
    "mcp:dev": "tsx src/mcp/server.ts",
    "mcp:build": "tsup src/mcp/server.ts --format cjs --out-dir dist --clean",
    "mcp:start": "node dist/server.cjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.8.0",
    "d3": "^7.9.0",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.5",
    "next": "^14.2.5",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.15",
    "pg": "^8.13.0",
    "playwright": "^1.49.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^41.0.3",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.5",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
