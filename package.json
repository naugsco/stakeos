{
  "name": "stakeos",
  "version": "1.2.2",
  "private": true,
  "description": "Private AI assistant and leadership dashboard for stake leadership.",
  "author": "Nicholas Naugle",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "predev": "node scripts/ensureNodeNativeAbi.mjs",
    "dev": "next dev",
    "prestart": "node scripts/ensureNodeNativeAbi.mjs",
    "rebuild:node": "npm rebuild better-sqlite3",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "build": "next build && npm run build:backend",
    "build:backend": "tsup src/mcp/server.ts src/sqlite/runFullSync.ts src/sqlite/runCallingSync.ts src/sqlite/init.ts src/sqlite/seedSyncSnapshots.ts src/sqlite/runSyncJob.ts --format cjs --out-dir dist --clean && node -e \"require('node:fs').copyFileSync('dist/mcp/server.cjs', 'dist/server.cjs')\"",
    "desktop:start": "node scripts/ensureNodeNativeAbi.mjs && electron electron/main.cjs",
    "desktop:clean": "rm -rf release",
    "desktop:reset-setup": "node scripts/resetLocalSetup.mjs",
    "desktop:prune-local-browsers": "rm -rf node_modules/playwright-core/.local-browsers",
    "desktop:check-release": "node scripts/checkMacReleasePrereqs.mjs",
    "desktop:pack": "npm run build && npm run rebuild:electron && npm run desktop:prune-local-browsers && electron-builder --dir",
    "desktop:release": "npm run desktop:clean && npm run build && npm run rebuild:electron && npm run desktop:prune-local-browsers && electron-builder --mac zip dmg",
    "desktop:dist": "npm run desktop:release",
    "release:notes:init": "node scripts/initReleaseNotes.mjs",
    "release:publish": "node scripts/publishRelease.mjs",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "sqlite:init": "tsx src/sqlite/init.ts",
    "sqlite:sync": "tsx src/sqlite/runFullSync.ts",
    "sqlite:callings": "tsx src/sqlite/runCallingSync.ts",
    "sqlite:seed-baseline": "tsx src/sqlite/seedSyncSnapshots.ts",
    "mcp:dev": "tsx src/mcp/server.ts",
    "mcp:build": "tsup src/mcp/server.ts --format cjs --out-dir dist --clean",
    "mcp:start": "node dist/server.cjs",
    "test:lcr-parser": "tsx scripts/verifyLcrReportParser.ts",
    "test:transit": "tsx scripts/verifyTransitNextBus.ts",
    "bus:next": "tsx scripts/showNextBus.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.8.0",
    "adm-zip": "^0.6.0",
    "better-sqlite3": "^12.8.0",
    "d3": "^7.9.0",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.5",
    "gtfs-realtime-bindings": "^2.2.0",
    "next": "^14.2.5",
    "nodemailer": "^6.9.15",
    "playwright": "^1.49.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.1",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "electron": "^41.0.3",
    "electron-builder": "^26.0.12",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.5",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "build": {
    "appId": "org.stakeos.desktop",
    "productName": "StakeOS Desktop",
    "icon": "build/icon.icns",
    "asar": false,
    "afterSign": "build/notarize.cjs",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "artifactName": "StakeOS-Desktop-${version}-${arch}.${ext}",
    "files": [
      "electron/**/*",
      ".next/**/*",
      "dist/**/*",
      "public/**/*",
      "src/sqlite/schema.sql",
      "package.json",
      "package-lock.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        "zip",
        "dmg"
      ]
    },
    "dmg": {
      "artifactName": "StakeOS-Desktop-${version}-${arch}.${ext}",
      "sign": false
    }
  }
}
