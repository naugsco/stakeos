# Core
NODE_ENV=development
# SQLITE_DB_PATH=  # optional override; defaults to ~/Library/Application Support/StakeOS/stakeos.db

# Playwright
PLAYWRIGHT_USER_DATA_DIR=.playwright/profile
PLAYWRIGHT_HEADLESS=false
LCR_DIRECTORY_URL=https://lcr.churchofjesuschrist.org/mlt/report/create-a-report/custom-reports-details/YOUR-REPORT-ID
LCR_TIMEOUT_MS=180000

# Optional email (advanced MCP workflows only)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional dashboard metadata
STAKE_NAME=Example Stake
UNIT_NUMBER=000000

# Optional report recipients (comma-separated)
STAKE_PRESIDENCY_EMAILS=
STAKE_COUNCIL_EMAILS=

# Optional next-bus board (/bus). Free API key: https://developer.translink.ca
TRANSLINK_API_KEY=
# Defaults below point at W Georgia St @ Cardero St, Vancouver.
# TRANSLINK_STOP_LAT=49.2911
# TRANSLINK_STOP_LON=-123.1350
# TRANSLINK_STOP_RADIUS_M=250
# Pin exact stop numbers instead of searching by radius (npm run bus:next -- --stops)
# TRANSLINK_STOP_CODES=51474,60645
# TRANSLINK_ROUTES=19,250
# TRANSLINK_HORIZON_MINUTES=90
# TRANSLINK_MAX_DEPARTURES=12
# TRANSLINK_GTFS_STATIC_URL=
